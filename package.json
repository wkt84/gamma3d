{
  "name": "gamma3d",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "3D gamma analysis for RTDOSE (browser-based, static)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "gen:samples": "node scripts/gen-samples.ts",
    "test:e2e": "playwright test",
    "validate": "npm run gen:samples && node validation/export.ts && uv run validation/compare.py",
    "build:wasm": "cd wasm && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/gamma3d_kernel.wasm ../src/wasm/gamma3d_kernel.wasm",
    "fonts:latin": "./scripts/subset-fonts.sh"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.21.0"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "core-js": false
  }
}
