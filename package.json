{
  "name": "gamma3d",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "3D gamma analysis for RTDOSE (browser-based, static)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "gen:samples": "node scripts/gen-samples.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.21.0"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "core-js": false
  }
}
